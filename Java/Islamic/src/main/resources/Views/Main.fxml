<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.IcyDrae.Controllers.MainController">
    <!-- LEFT MENU -->
    <left>
        <VBox fx:id="menuPanel"
              prefWidth="240"
              spacing="5"
              style="
                    -fx-background-color:#123B3A;
                    -fx-padding:15;
              ">
            <Label text="Islamic"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="
                        -fx-font-size:30px;
                        -fx-font-weight:bold;
                        -fx-text-fill:#C9A24A;
                        -fx-padding:0 0 20 0;
                   "/>
            <Button fx:id="prayerButton"
                    text="Prayer Times"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#prayerClicked"/>
            <Button fx:id="tomorrowButton"
                    text="Tomorrow's Prayers"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#tomorrowClicked"/>
            <Button fx:id="dhikrButton"
                    text="Dhikr"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#dhikrClicked"/>
            <Button fx:id="quranButton"
                    text="Qur'an"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#quranClicked"/>
            <Button fx:id="hijriButton"
                    text="Hijri Calendar"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#hijriClicked"/>
            <Button fx:id="fastingButton"
                    text="Fasting Days"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#fastingClicked"/>
            <Button fx:id="namesButton"
                    text="99 Names"
                    maxWidth="Infinity"
                    prefHeight="50"
                    onAction="#namesClicked"/>
        </VBox>
    </left>

    <!-- RIGHT SIDE -->
    <center>
        <VBox spacing="20"
              style="
                    -fx-background-color:#F5F3EE;
                    -fx-padding:20;
              ">
            <!-- Notification Card -->
            <HBox fx:id="notificationCard"
                  spacing="25"
                  alignment="CENTER_LEFT"
                  style="
                        -fx-background-color:white;
                        -fx-background-radius:18;
                        -fx-padding:20;
                        -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0.2, 0, 3);
                  ">
                <VBox spacing="5">
                    <Label text="🔔 Next Prayer Notification"
                           style="
                                -fx-font-size:22px;
                                -fx-font-weight:bold;
                                -fx-text-fill:#C9A24A;
                           "/>
                    <Label fx:id="notificationPrayer"
                           text="Loading..."
                           style="
                                -fx-font-size:20px;
                                -fx-font-weight:bold;
                                -fx-text-fill:#123B3A;
                           "/>
                    <Label fx:id="notificationTime"
                           text=""
                           style="
                                -fx-font-size:17px;
                                -fx-text-fill:#555555;
                           "/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER"
                      spacing="5">
                    <Label text="Remaining"
                           style="
                                -fx-font-size:16px;
                                -fx-text-fill:#888888;
                           "/>
                    <Label fx:id="countdownLabel"
                           text="--:--:--"
                           style="
                                -fx-font-size:34px;
                                -fx-font-weight:bold;
                                -fx-text-fill:#123B3A;
                           "/>
                </VBox>
            </HBox>
            <!-- Current Page -->
            <StackPane fx:id="mainContent"
                       VBox.vgrow="ALWAYS"
                       style="
                            -fx-background-color:#F5F3EE;
                            -fx-font-size: 20px;
                       "/>
        </VBox>
    </center>
</BorderPane>
