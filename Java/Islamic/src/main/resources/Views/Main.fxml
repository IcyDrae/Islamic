<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.IcyDrae.Controllers.MainController">

    <!-- LEFT SIDEBAR -->
    <left>

        <VBox fx:id="menuPanel"
              prefWidth="220"
              style="-fx-background-color:#123B3A;">

            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Label text="Islamic"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="
                        -fx-text-fill:#C9A24A;
                        -fx-font-size:24px;
                        -fx-font-weight:bold;
                   "/>

            <Button fx:id="prayerButton"
                    text="Prayer Times"
                    onAction="#prayerClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <Button fx:id="tomorrowButton"
                    text="Tomorrow's Prayers"
                    onAction="#tomorrowClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <Button fx:id="dhikrButton"
                    text="Dhikr"
                    onAction="#dhikrClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <Button fx:id="quranButton"
                    text="Quran"
                    onAction="#quranClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <Button fx:id="hijriButton"
                    text="Hijri Calendar"
                    onAction="#hijriClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <Button fx:id="fastingButton"
                    text="Fasting Days"
                    onAction="#fastingClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <Button fx:id="namesButton"
                    text="99 Names"
                    onAction="#namesClicked"
                    maxWidth="Infinity"
                    prefHeight="50"
                    style="
                        -fx-font-size:16px;
                        -fx-background-color:transparent;
                        -fx-text-fill:#E8E6E1;
                        -fx-alignment:CENTER_LEFT;
                    "/>

            <!-- Pushes everything above to the top -->
            <StackPane VBox.vgrow="ALWAYS"/>

        </VBox>

    </left>

    <!-- MAIN CONTENT -->
    <center>

        <StackPane fx:id="mainContent"
                   style="
                        -fx-background-color:#F5F3EE;
                        -fx-padding:20;
                        -fx-font-size: 20px;
                   "/>

    </center>

</BorderPane>