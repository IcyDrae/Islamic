<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.IcyDrae.Controllers.FastingController"
            fitToWidth="true"
            style="
              -fx-background-color:#F5F3EE;
            ">
    <content>
        <VBox alignment="CENTER"
              spacing="25"
              style="
              -fx-background-color:#F5F3EE;
              -fx-padding:40;
              ">
            <Label text="Fasting Days"
                   style="
                   -fx-font-size:32px;
                   -fx-font-weight:bold;
                   -fx-text-fill:#C9A24A;
                   "/>

            <!-- Ramadan -->
            <VBox fx:id="ramadanCard"
                  prefWidth="700"
                  maxWidth="700"
                  alignment="CENTER"
                  spacing="10"
                  style="
                  -fx-background-color:white;
                  -fx-padding:25;
                  -fx-background-radius:15;
                  ">
                <Label text="🌙 Ramadan"
                       style="
                       -fx-font-size:24px;
                       -fx-font-weight:bold;
                       -fx-text-fill:#123B3A;
                       "/>
                <Label fx:id="ramadanLabel"
                       prefWidth="650"
                       wrapText="true"
                       alignment="CENTER"
                       style="
                       -fx-font-size:18px;
                       -fx-text-fill:#123B3A;
                       "/>
            </VBox>

            <!-- Monday Thursday -->
            <VBox prefWidth="700"
                  maxWidth="700"
                  alignment="CENTER"
                  spacing="10"
                  style="
                  -fx-background-color:white;
                  -fx-padding:25;
                  -fx-background-radius:15;
                  ">
                <Label text="⭐ Monday &amp; Thursday"
                       style="
                       -fx-font-size:24px;
                       -fx-font-weight:bold;
                       -fx-text-fill:#123B3A;
                       "/>
                <Label fx:id="weeklyLabel"
                       prefWidth="650"
                       wrapText="true"
                       alignment="CENTER"
                       style="
                       -fx-font-size:18px;
                       -fx-text-fill:#123B3A;
                       "/>
            </VBox>

            <!-- White Days -->
            <VBox prefWidth="700"
                  maxWidth="700"
                  alignment="CENTER"
                  spacing="10"
                  style="
                  -fx-background-color:white;
                  -fx-padding:25;
                  -fx-background-radius:15;
                  ">
                <Label text="🌕 White Days"
                       style="
                       -fx-font-size:24px;
                       -fx-font-weight:bold;
                       -fx-text-fill:#123B3A;
                       "/>

                <Label fx:id="whiteDaysLabel"
                       prefWidth="650"
                       wrapText="true"
                       alignment="CENTER"
                       style="
                       -fx-font-size:18px;
                       -fx-text-fill:#123B3A;
                       "/>
            </VBox>

            <!-- Voluntary -->
            <VBox prefWidth="700"
                  maxWidth="700"
                  alignment="CENTER"
                  spacing="10"
                  style="
                  -fx-background-color:white;
                  -fx-padding:25;
                  -fx-background-radius:15;
                  ">

                <Label text="🤲 Voluntary Fasting"
                       style="
                       -fx-font-size:24px;
                       -fx-font-weight:bold;
                       -fx-text-fill:#123B3A;
                       "/>
                <Label fx:id="voluntaryLabel"
                       prefWidth="650"
                       wrapText="true"
                       alignment="CENTER"
                       style="
                       -fx-font-size:18px;
                       -fx-text-fill:#123B3A;
                       "/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
